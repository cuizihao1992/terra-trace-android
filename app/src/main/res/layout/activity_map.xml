<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/closeMapButton"
            android:layout_width="88dp"
            android:layout_height="40dp"
            android:background="@drawable/secondary_button"
            android:text="@string/close_map"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/map_title"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="88dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.terratrace.map.TerraTraceMapView
            android:id="@+id/terraTraceMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/zoomInButton"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:background="@drawable/secondary_button"
                android:text="@string/zoom_in"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="20sp" />

            <Button
                android:id="@+id/zoomOutButton"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/secondary_button"
                android:text="@string/zoom_out"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/locationButton"
                android:layout_width="76dp"
                android:layout_height="44dp"
                android:background="@drawable/secondary_button"
                android:text="@string/location"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <Button
                android:id="@+id/baseMapButton"
                android:layout_width="76dp"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/secondary_button"
                android:text="@string/base_map"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/panel"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/map_loading"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/trackCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:checked="true"
                        android:text="@string/layer_track" />

                    <CheckBox
                        android:id="@+id/pointsCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:checked="true"
                        android:text="@string/layer_points" />

                    <CheckBox
                        android:id="@+id/polygonCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:checked="true"
                        android:text="@string/layer_polygon" />

                    <CheckBox
                        android:id="@+id/wmtsCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="@string/layer_wmts" />

                    <CheckBox
                        android:id="@+id/wmsCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="@string/layer_wms" />

                    <CheckBox
                        android:id="@+id/mvtCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="@string/layer_mvt" />
                </LinearLayout>
            </HorizontalScrollView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/drawPointButton"
                        android:layout_width="72dp"
                        android:layout_height="40dp"
                        android:background="@drawable/secondary_button"
                        android:text="@string/draw_point"
                        android:textAllCaps="false"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/drawLineButton"
                        android:layout_width="72dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/secondary_button"
                        android:text="@string/draw_line"
                        android:textAllCaps="false"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/drawPolygonButton"
                        android:layout_width="72dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/secondary_button"
                        android:text="@string/draw_polygon"
                        android:textAllCaps="false"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/drawStopButton"
                        android:layout_width="72dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/secondary_button"
                        android:text="@string/draw_stop"
                        android:textAllCaps="false"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/drawUndoButton"
                        android:layout_width="72dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/secondary_button"
                        android:text="@string/draw_undo"
                        android:textAllCaps="false"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/drawClearButton"
                        android:layout_width="72dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/secondary_button"
                        android:text="@string/draw_clear"
                        android:textAllCaps="false"
                        android:textSize="13sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/measureDistanceButton"
                        android:layout_width="72dp"
                        android:layout_height="40dp"
                        android:background="@drawable/secondary_button"
                        android:text="@string/measure_distance"
                        android:textAllCaps="false"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/measureAreaButton"
                        android:layout_width="72dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/secondary_button"
                        android:text="@string/measure_area"
                        android:textAllCaps="false"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/measureClearButton"
                        android:layout_width="72dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/secondary_button"
                        android:text="@string/measure_clear"
                        android:textAllCaps="false"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/exportGeoJsonButton"
                        android:layout_width="72dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/secondary_button"
                        android:text="@string/export_geojson"
                        android:textAllCaps="false"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/playTrackButton"
                        android:layout_width="72dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/secondary_button"
                        android:text="@string/play_track"
                        android:textAllCaps="false"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/pauseTrackButton"
                        android:layout_width="72dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/secondary_button"
                        android:text="@string/pause_track"
                        android:textAllCaps="false"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/resetTrackButton"
                        android:layout_width="72dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/secondary_button"
                        android:text="@string/reset_track"
                        android:textAllCaps="false"
                        android:textSize="13sp" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
